{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "HotelDb": "Host=localhost;Port=5432;Database=hotel_db;Username=hotel_service;Password=hotel_dev_pw",
    "Redis": "localhost:6379,password=redis_dev_pw"
  },
  "Messaging": {
    "Kafka": {
      "ClientId": "hotel-api",
      "BootstrapServers": "localhost:9092",
      "MessageTimeout": 5000,
      "RequestTimeout": 2000
    },
    "Outbox": {
      "BatchSize": 100,
      "PollIntervalSeconds": 5,
      "MaxRetries": 5
    }
  },
  "Observability": {
    "Seq": {
      "Url": "http://localhost:5341"
    },
    "OpenTelemetry": {
      "Endpoint": "http://localhost:4317"
    }
  }
}
