    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FastEndpoints" Version="8.2.0" />
    <PackageReference Include="FastEndpoints.OpenApi" Version="8.2.0" />
    <PackageReference Include="Microsoft.OpenApi" Version="2.11.0" />
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" Version="6.8.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\BuildingBlocks\HBP.Messaging.Kafka\HBP.Messaging.Kafka.csproj" />
    <ProjectReference Include="..\..\..\BuildingBlocks\HBP.Observability\HBP.Observability.csproj" />
    <ProjectReference Include="..\HBP.Hotel.Application\HBP.Hotel.Application.csproj" />
    <ProjectReference Include="..\HBP.Hotel.Infrastructure\HBP.Hotel.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\..\..\.dockerignore">
      <Link>.dockerignore</Link>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="HBP.Hotel.API.UnitTests" />
  </ItemGroup>
</Project>
