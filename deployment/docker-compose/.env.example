# Значения по умолчанию предназначены только для локальной разработки.

# --- Postgres (admin и пароли сервисных ролей) -------------------------------
POSTGRES_USER=hbp_admin
POSTGRES_PASSWORD=hbp_dev_password

HOTEL_SERVICE_PASSWORD=hotel_dev_pw
INVENTORY_SERVICE_PASSWORD=inventory_dev_pw
BOOKING_SERVICE_PASSWORD=booking_dev_pw
PRICING_SERVICE_PASSWORD=pricing_dev_pw
PAYMENT_SERVICE_PASSWORD=payment_dev_pw
GUEST_SERVICE_PASSWORD=guest_dev_pw
NOTIFICATION_SERVICE_PASSWORD=notification_dev_pw
REPORTING_SERVICE_PASSWORD=reporting_dev_pw

# --- Redis -------------------------------------------------------------------
REDIS_PASSWORD=redis_dev_pw

# --- Kafka (KRaft, single-node для dev) -------------------------------------
KAFKA_NODE_ID=1
KAFKA_PROCESS_ROLES=broker,controller
KAFKA_CONTROLLER_QUORUM_VOTERS=1@kafka:9093
KAFKA_LISTENERS=PLAINTEXT://:9092,CONTROLLER://:9093
KAFKA_ADVERTISED_LISTENERS=PLAINTEXT://kafka:9092
KAFKA_LISTENER_SECURITY_PROTOCOL_MAP=CONTROLLER:PLAINTEXT,PLAINTEXT:PLAINTEXT
KAFKA_CONTROLLER_LISTENER_NAMES=CONTROLLER
KAFKA_INTER_BROKER_LISTENER_NAME=PLAINTEXT
KAFKA_AUTO_CREATE_TOPICS_ENABLE=false
# Replication 1 обязателен для single-broker dev, иначе __consumer_offsets
# не сможет создаться при дефолтном факторе 3.
KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR=1
KAFKA_TRANSACTION_STATE_LOG_REPLICATION_FACTOR=1
KAFKA_TRANSACTION_STATE_LOG_MIN_ISR=1
KAFKA_PARTITIONS=3
KAFKA_REPLICATION=1
KAFKA_RETENTION_MS=604800000

# --- Seq ---------------------------------------------------------------------
SEQ_ACCEPT_EULA=Y
# Пароль admin-пользователя при первом запуске (логин по умолчанию: admin).
SEQ_FIRSTRUN_ADMINPASSWORD=seq_dev_pw

# --- Grafana -----------------------------------------------------------------
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin
GF_USERS_ALLOW_SIGN_UP=false
