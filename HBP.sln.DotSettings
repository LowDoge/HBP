  <s:String x:Key="/Default/CodeStyle/CSharpTypeMemberLayout/Pattern/@EntryValue">
    <![CDATA[<Patterns xmlns="urn:shemas-jetbrains-com:member-reordering-pattern">
  <Pattern Priority="100">
