  <Pattern Priority="3">
    <Kind Is="Record"/>
  </Pattern>
  <Pattern Priority="2">
    <Kind Is="Class"/>
  </Pattern>
  <Pattern Priority="1">
    <Any/>
  </Pattern>
</Patterns>]]>
