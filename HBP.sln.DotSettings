  </Pattern>
  <Pattern Priority="45">
    <Kind Is="Destructor"/>
  </Pattern>
  <Pattern Priority="40">
    <Kind Is="Delegate"/>
  </Pattern>
  <Pattern Priority="30">
    <Kind Is="Event"/>
  </Pattern>
  <Pattern Priority="29">
