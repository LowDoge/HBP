  </Pattern>
  <Pattern Priority="14">
    <Kind Is="Operator"/>
  </Pattern>
  <Pattern Priority="10">
    <Kind Is="Method"/>
  </Pattern>
  <Pattern Priority="5">
    <Kind Is="Struct"/>
  </Pattern>
  <Pattern Priority="4">
